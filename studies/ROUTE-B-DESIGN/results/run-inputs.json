{
  "studies/ROUTE-B-DESIGN/config.yaml": {
    "version": "ROUTE-B-DESIGN-1.0",
    "evidence_level": "design_assumption",
    "objective": "在给定参考载荷与许用应力假设下，比较实际沉积截面对应的连接能力和名义净热输入",
    "sources": {
      "process": "project/process.yaml",
      "materials": "project/materials.yaml",
      "geometry": "cad/parametric/geometry.json",
      "load_basis": "project/load-basis-v1.yaml",
      "tolerance": "project/tolerance.yaml",
      "structural_uncertainty": "simulation/structural-v4/results/struct-uncertainty/assessment.json"
    },
    "load_scales": [
      0.5,
      1.0,
      1.5
    ],
    "load_scale_basis": "同比例缩放径向力、轴向力和倾覆力矩的确定性敏感性；不是整机载荷或概率",
    "process_scenarios": [
      "current_single_pass_diagnostic",
      "target_3p5_four_pass_candidate"
    ],
    "feed_setting_policy": "按现有名义沉积效率设定固定送丝，再在原配置沉积效率两端核算实际面积；不假定逐件已知效率并调参",
    "selection": {
      "objective": "nominal_net_heat_input_j",
      "constraint": "参考焊缝组模型在声明沉积效率范围内的最大应力不超过假设许用应力",
      "interpretation": "仅在六个候选内给出条件承载筛查后的低热输入研究优先项，不代表完整工艺可行或全局最优"
    },
    "precision": {
      "thermal_radial_allocations_mm": [
        0.002,
        0.005,
        0.008,
        0.011,
        0.012
      ],
      "adjustable_contributions": [
        "fixture_repeatability",
        "initial_assembly"
      ],
      "interpretation": "反算要求，不是设备能力、计算变形或实测公差"
    },
    "release": {
      "product_position_acceptance_claim_allowed": false,
      "welding_procedure_qualified": false,
      "fatigue_life_claim_allowed": false,
      "cleanliness_validated": false
    }
  },
  "project/process.yaml": {
    "version": "PROCESS-1.0",
    "authority": "焊接工艺与填丝参数的唯一权威配置",
    "process": {
      "nominal": {
        "method": "automatic_TIG",
        "current_a": 75.0,
        "voltage_v": 12.0,
        "travel_speed_mm_s": 1.5,
        "arc_efficiency": 0.55,
        "heat_input_j_per_mm": 330.0,
        "preheat_c": 150.0,
        "interpass_limit_c": 200.0,
        "filler_feed_rate_mm_s": 2.0,
        "filler_diameter_mm": 1.2,
        "shielding_gas": "99.999% Ar",
        "gas_flow_rate_l_min": 10.0,
        "tungsten_electrode": "W-La20 (Ø2.0 mm)",
        "nozzle_diameter_mm": 10.0,
        "standoff_distance_mm": 2.5
      },
      "joint_consistency": {
        "design_fillet_leg_mm": 3.5,
        "design_basis": "结构设计目标；承载、疲劳和宏观截面尚未验证",
        "deposition_efficiency_nominal": 1.0,
        "deposition_efficiency_range": [
          0.85,
          1.0
        ],
        "closure_status": "not_closed_pending_macrosection_and_load_basis",
        "rule": "设计焊脚、实测成形截面、耗丝/增重和仿真沉积几何必须联合确认；禁止把母材熔化体积计作新增填丝",
        "scenarios": {
          "current_single_pass_diagnostic": {
            "pass_count": 1,
            "identity": "当前 1.737 mm 等效焊脚局部热诊断基线",
            "disposition": "diagnostic_only"
          },
          "target_3p5_four_pass_candidate": {
            "pass_count": 4,
            "identity": "3.5 mm 理想三角截面的等面积四道设计候选",
            "disposition": "candidate_pending_load_basis_macrosection_and_thermal_revalidation",
            "feed_policy": "每道按相同目标沉积面积反算送丝；效率 0.85~1.0 作为边界，不取单一 WPS 值",
            "thermal_policy": "四道总弧能与层间温度历史必须建立新输入版本重算，不继承单道收敛结论"
          }
        }
      },
      "acceptable_window": {
        "current_a": {
          "min": 65.0,
          "nominal": 75.0,
          "max": 85.0
        },
        "voltage_v": {
          "min": 11.0,
          "nominal": 12.0,
          "max": 13.5
        },
        "travel_speed_mm_s": {
          "min": 1.2,
          "nominal": 1.5,
          "max": 2.0
        },
        "heat_input_j_per_mm": {
          "min": 240.0,
          "max": 420.0
        },
        "preheat_c": {
          "min": 130.0,
          "nominal": 150.0,
          "max": 180.0
        },
        "interpass_limit_c": {
          "max": 200.0
        }
      },
      "sequence_strategies": [
        {
          "name": "S1",
          "type": "continuous_sequential",
          "description": "顺次焊接，热累积极高，非对称变形大"
        },
        {
          "name": "S2",
          "type": "fixed_diagonal",
          "description": "固定对角跳焊，热对称性较好"
        },
        {
          "name": "S3",
          "type": "fixed_intermittent",
          "description": "固定六点跳焊序列 1->4->3->6->2->5"
        },
        {
          "name": "ADAPTIVE",
          "type": "temperature_state_driven",
          "description": "在线测温反馈 + 动态加权选段跳焊，受邻段道温门限与温差约束"
        }
      ]
    }
  },

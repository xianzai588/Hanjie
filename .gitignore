# Simulation heavy outputs
*.odb
*.rst
*.rth
*.cas
*.res
*.sim
*.lock

# Temporary
*.tmp
*.bak
~$*

# Python
__pycache__/
*.pyc
.venv/

# Reproducible digital-sample renders (regenerate with automation/vision/run_benchmark.py)
automation/vision/data/*.png
automation/vision/data/**/*.png

# Local exploratory FE fixture scans; official cases are FE-001..005.
simulation/cases/K*/
simulation/cases/baseline-rigid/
simulation/cases/baseline-compliant/
simulation/cases/flex-rigid/
simulation/cases/flex-compliant/

# Plan 5 首次 NEST-M 仅在严格 JSON 序列化阶段失败；保留本地排障，不作为证据提交。
simulation/thermal-v5/results/nested-refinement-study/NEST-M_failed_serialization/

# 被质量门拒绝的可重复生成网格；版本库保留参数、统计和逐单元诊断。
simulation/structural-v4/results/struct0-prep/continuous-unified-plan5.msh
simulation/structural-v4/results/struct0-prep/continuous-unified-plan5-delaunay.msh

# 可重复生成的 Elmer 网格、插件二进制与排障输出。
output/thermal-ref-dev/
simulation/thermal-ref/results/**/mesh/
simulation/thermal-ref/results/**/mesh-data.npz
simulation/thermal-ref/results/**/reference.dat
simulation/thermal-ref/results/**/ReferenceCallbacks.dll
simulation/thermal-ref/results/**/compile.log
simulation/thermal-ref/results/**/*.mod
simulation/thermal-ref/results/**/field-*.dat
simulation/thermal-ref/results/**/temperature.vtu
simulation/thermal-ref/results/**/initial-temperature.dat
simulation/thermal-ref/results/**/window-fields.npz

# 评审用页面渲染图与本地排障中间件；由 PDF 随时重新导出，不入版本库。
output/review-png/
output/tmp/*.png
output/tmp/*.txt

# IDE
.vscode/
.idea/

# Agent 工作区本地数据（会话记忆/临时状态）；交付物与证据仍按正常路径入库
.workbuddy/

# OS
.DS_Store
Thumbs.db

# Ring FE raw meshes/fields are reproducible working files. Publish result
# tables, input identities, balances and plots; rerun solvers for full fields.
simulation/ring-baseline-structure/results/**/*.npz
simulation/ring-baseline-structure/results/**/*.msh
simulation/ring-baseline-manufacturing/results/**/*.npz
simulation/ring-baseline-manufacturing/results/**/*.msh
simulation/ring-baseline-structure/*.log
simulation/ring-baseline-manufacturing/*.log
# This 7.3 MB immutable support snapshot is needed to reproduce the retained
# independent medium eigenstrain check; its original mesh build was not cached.
!simulation/ring-baseline-structure/results/medium/mesh.npz

# Solver progress is transient; final ledgers and histories are retained.
simulation/ring-baseline-manufacturing/results/**/progress.json
simulation/ring-baseline-structure/figures/.*
# Large competition ZIP is published as checked 8 MiB Git volumes.
deliverables/焊接固定题-参赛设计报告包.zip

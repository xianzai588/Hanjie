Header
  Mesh DB "." "mesh"
End
Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Output File = "cold.result"
  Post File = "cold.vtu"
  Max Output Level = 5
  Restart File = "hot.result"
End
Body 1
  Equation = 1
  Material = 1
End
Material 1
  Youngs Modulus = 170000.0
  Poisson Ratio = 0.28
  Heat Expansion Coefficient = 1.14e-05
  Reference Temperature = 40.0
  Density = 7.195077444855725e-06
  Heat Conductivity = 0.04
  Heat Capacity = 500
End
Body 2
  Equation = 1
  Material = 2
End
Material 2
  Youngs Modulus = 205000.0
  Poisson Ratio = 0.31
  Heat Expansion Coefficient = 1.33e-05
  Reference Temperature = 40.0
  Density = 8.88290955245251e-06
  Heat Conductivity = 0.04
  Heat Capacity = 500
End
Equation 1
  Active Solvers(2) = 1 2
End
Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
  Linear System Convergence Tolerance = 1e-12
End
Solver 2
  Equation = Linear Elasticity
  Procedure = "StressSolve" "StressSolver"
  Variable = -dofs 3 Displacement
  Calculate Stresses = True
  Calculate Strains = True
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
  Linear System Convergence Tolerance = 1e-12
End
Boundary Condition 1
  Target Boundaries(1) = 1
  Temperature = 20
  Displacement 1 = 0
End
Boundary Condition 2
  Target Boundaries(1) = 2
  Temperature = 20
  Displacement 1 = 0
End
Boundary Condition 3
  Target Boundaries(1) = 3
  Temperature = 20
  Displacement 2 = 0
End
Boundary Condition 4
  Target Boundaries(1) = 4
  Temperature = 20
  Displacement 3 = 0
End
